<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1734;CS1735</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="OfflineDirectChunkWireEncoder.cs" />
    <Compile Remove="RemoteApplicationEventServer.cs" />
    <Compile Remove="RemoteChatServer.cs" />
    <Compile Remove="RemoteChunkWorldStateServer.cs" />
    <Compile Remove="RemoteControlledSimulationServer.cs" />
    <Compile Remove="RemoteDirtyChunkSpatialFanoutServer.cs" />
    <Compile Remove="RemoteDirtyEntitySpatialFanoutServer.cs" />
    <Compile Remove="RemoteGameApplicationSession.cs" />
    <Compile Remove="RemoteGuestPlayableApplication.cs" />
    <Compile Remove="RemoteWorldStateCompactionScheduler.cs" />
    <Compile Remove="RemoteWorldStateServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Kernels/ECS/UltraSim.ECS.csproj" />
    <ProjectReference Include="../Admission/UltraSim.Game.Admission.csproj" />
    <ProjectReference Include="../Composition/UltraSim.Game.Composition.csproj" />
    <ProjectReference Include="../Contracts/UltraSim.Game.Contracts.csproj" />
    <ProjectReference Include="../World/UltraSim.Game.World.csproj" />
    <ProjectReference Include="../../Server/Runtime/UltraSim.Server.Runtime.csproj" />
  </ItemGroup>
</Project>
