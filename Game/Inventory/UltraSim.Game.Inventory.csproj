    <ProjectReference Include="../../Client/Core/UltraSim.Client.Core.csproj" />
    <ProjectReference Include="../Accounting/UltraSim.Game.Accounting.csproj" />
    <ProjectReference Include="../Persistence/UltraSim.Game.Persistence.csproj" />
    <ProjectReference Include="../../Server/Persistence/UltraSim.Server.Persistence.csproj" />
    <ProjectReference Include="../../Server/Runtime/UltraSim.Server.Runtime.csproj" />
  </ItemGroup>
</Project>
