{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OfficialRegistry": {
    "EnablePolling": true,
    "PollIntervalSeconds": 15,
    "PollTimeoutSeconds": 5,
    "PollFailureThreshold": 3,
    "PollMaxConcurrency": 8,
    "EnableStatePersistence": true,
    "StateFilePath": "data/dev-registry-state.json",
    "PersistenceFlushIntervalMilliseconds": 1000,
    "LeaseSeconds": 45,
    "UnverifiedRegisterCooldownSeconds": 10,
    "PortalApiToken": "local-portal-token",
    "AdminApiToken": "local-admin-token",
    "AllowPrivateStatusEndpointTargets": true,
    "EnableBenchmarkRateLimitBypass": true,
    "BenchmarkRateLimitBypassToken": "local-benchmark"
  }
}
