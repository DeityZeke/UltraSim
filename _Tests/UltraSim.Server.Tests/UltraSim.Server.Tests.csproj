<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UltraSim.Server.Core">
      <HintPath>..\..\Server\Core\bin\$(Configuration)\net8.0\UltraSim.Server.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Hosting">
      <HintPath>..\..\Server\Hosting\bin\$(Configuration)\net8.0\UltraSim.Server.Hosting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Headless">
      <HintPath>..\..\Server\_Headless\bin\$(Configuration)\net8.0\UltraSim.Server.Headless.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Console">
      <HintPath>..\..\Server\_Console\bin\$(Configuration)\net8.0\UltraSim.Server.Console.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildServerDependencies" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\..\Server\Core\UltraSim.Server.Core.csproj;..\..\Server\Hosting\UltraSim.Server.Hosting.csproj;..\..\Server\_Headless\UltraSim.Server.Headless.csproj;..\..\Server\_Console\UltraSim.Server.Console.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
