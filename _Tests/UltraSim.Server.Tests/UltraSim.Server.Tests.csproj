<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UltraSim.Server.Core">
      <HintPath>..\..\Server\Core\bin\$(Configuration)\net8.0\UltraSim.Server.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Network">
      <HintPath>..\..\Server\Network\bin\$(Configuration)\net8.0\UltraSim.Server.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Hosting">
      <HintPath>..\..\Server\Hosting\bin\$(Configuration)\net8.0\UltraSim.Server.Hosting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Headless">
      <HintPath>..\..\Server\_Headless\bin\$(Configuration)\net8.0\UltraSim.Server.Headless.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Console">
      <HintPath>..\..\Server\_Console\bin\$(Configuration)\net8.0\UltraSim.Server.Console.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Server.Godot">
      <HintPath>..\..\Server\_Godot\.godot\mono\temp\bin\$(Configuration)\UltraSim.Server.Godot.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Network">
      <HintPath>..\..\Kernels\Network\bin\$(Configuration)\net8.0\UltraSim.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildServerDependencies" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\..\Kernels\Network\UltraSim.Network.csproj;..\..\Server\Core\UltraSim.Server.Core.csproj;..\..\Server\Network\UltraSim.Server.Network.csproj;..\..\Server\Hosting\UltraSim.Server.Hosting.csproj;..\..\Server\_Headless\UltraSim.Server.Headless.csproj;..\..\Server\_Console\UltraSim.Server.Console.csproj;..\..\Server\_Godot\UltraSim.Server.Godot.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
