<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>UltraSim.S0.Godot.Tests</AssemblyName>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../UltraSim.World.Testing/W5TwoPackFixture.cs" Link="W5TwoPackFixture.cs" />
    <ProjectReference Include="../../Client/Core/UltraSim.Client.Core.csproj" />
    <ProjectReference Include="../../Client/StandardUi/UltraSim.Client.StandardUi.csproj" />
    <ProjectReference Include="../../Framework/ControlPlane/UltraSim.Framework.ControlPlane.csproj" />
    <ProjectReference Include="../../Client/Content/UltraSim.Client.Content.csproj" />
    <ProjectReference Include="../../Client/BuiltInTestWorlds/UltraSim.Client.BuiltInTestWorlds.csproj" />
    <ProjectReference Include="../../Client/Network/UltraSim.Client.Network.csproj" />
    <ProjectReference Include="../../Game/Admission/UltraSim.Game.Admission.csproj" />
    <ProjectReference Include="../../Game/Composition/UltraSim.Game.Composition.csproj" />
    <ProjectReference Include="../../Game/Persistence/UltraSim.Game.Persistence.csproj" />
    <ProjectReference Include="../../Game/Protocol/UltraSim.Game.Protocol.csproj" />
    <ProjectReference Include="../../Game/Replication/UltraSim.Game.Replication.csproj" />
    <ProjectReference Include="../../Game/Replication.Remote/UltraSim.Game.Replication.Remote.csproj" />
    <ProjectReference Include="../../Game/World/UltraSim.Game.World.csproj" />
    <ProjectReference Include="../../Game/UI/UltraSim.Game.UI.csproj" />
    <ProjectReference Include="../../Kernels/Network/UltraSim.Network.csproj" />
    <ProjectReference Include="../../Kernels/Network.Testing/UltraSim.Network.Testing.csproj" />
    <ProjectReference Include="../../Kernels/Spatial/UltraSim.Spatial.csproj" />
    <ProjectReference Include="../../Server/Persistence/UltraSim.Server.Persistence.csproj" />
    <ProjectReference Include="../../Server/Runtime/UltraSim.Server.Runtime.csproj" />
  </ItemGroup>

  <!-- Compile the production adapter source into this isolated Godot acceptance assembly. The
       maintained application itself has exactly one script-bearing assembly and never references
       another Godot SDK project. -->
  <ItemGroup>
    <Compile Include="../../Client/Godot/Adapter/*.cs" Link="ClientAdapter/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
