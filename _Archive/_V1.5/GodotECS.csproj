<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <EnableUltraSimAgnosticGuard>true</EnableUltraSimAgnosticGuard>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_OLD\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove=".godot\**\*.cs" />
    <Compile Remove=".mono\**\*.cs" />
    <Compile Remove="tmp_perf_probe\**\*.cs" />
    <Compile Remove="_tmp\csharp bot harness\**\*.cs" />
    <Compile Remove="UltraSim\Discovery\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="UltraSim\Discovery\UltraSim.Discovery.csproj" />
  </ItemGroup>

  <Target Name="ValidateUltraSimAgnostic" BeforeTargets="CoreCompile" Condition="'$(EnableUltraSimAgnosticGuard)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\validate_ultrasim_agnostic.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)\UltraSim&quot;" />
  </Target>
</Project>
