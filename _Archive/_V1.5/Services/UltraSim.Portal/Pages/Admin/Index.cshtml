@page
@model UltraSim.Portal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="portal-header">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Platform Dashboard</h1>
        <p>Registry runtime, account totals, and platform admin entry points.</p>
    </div>
</div>

<div class="admin-shell">
    <aside class="admin-nav">
        <partial name="_AdminNav" />
    </aside>

    <section class="admin-content">
        <section class="metric-section">
            <header class="metric-section-header">
                <h2>Site Metrics</h2>
            </header>

            <div class="metric-grid">
                <article class="metric-card">
                    <span class="metric-label">Accounts</span>
                    <strong class="metric-value">@Model.TotalAccounts</strong>
                    <span class="metric-sub">Registered portal users</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Accounts Today</span>
                    <strong class="metric-value">@Model.AccountsToday</strong>
                    <span class="metric-sub">Registered in the last 24 hours</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Accounts 7d</span>
                    <strong class="metric-value">@Model.Accounts7Days</strong>
                    <span class="metric-sub">Registered in the last 7 days</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Accounts 30d</span>
                    <strong class="metric-value">@Model.Accounts30Days</strong>
                    <span class="metric-sub">Registered in the last 30 days</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Active 24h</span>
                    <strong class="metric-value">@Model.ActiveAccounts24Hours</strong>
                    <span class="metric-sub">Accounts active in the last 24 hours</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Active 7d</span>
                    <strong class="metric-value">@Model.ActiveAccounts7Days</strong>
                    <span class="metric-sub">Accounts active in the last 7 days</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Active 30d</span>
                    <strong class="metric-value">@Model.ActiveAccounts30Days</strong>
                    <span class="metric-sub">Accounts active in the last 30 days</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Primary Owners</span>
                    <strong class="metric-value">@Model.PrimaryOwnerCount</strong>
                    <span class="metric-sub">Protected root owners</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Owners</span>
                    <strong class="metric-value">@Model.OwnerCount</strong>
                    <span class="metric-sub">Platform owners</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Admins</span>
                    <strong class="metric-value">@Model.AdminCount</strong>
                    <span class="metric-sub">Platform admins</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Developers</span>
                    <strong class="metric-value">@Model.DeveloperCount</strong>
                    <span class="metric-sub">Contributor badge holders</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Moderators</span>
                    <strong class="metric-value">@Model.ModeratorCount</strong>
                    <span class="metric-sub">Forum moderation roles</span>
                </article>
            </div>
        </section>

        <section class="metric-section">
            <header class="metric-section-header">
                <h2>Forum Metrics</h2>
            </header>

            <div class="metric-grid">
                <article class="metric-card">
                    <span class="metric-label">Sections</span>
                    <strong class="metric-value">@Model.ForumSectionCount</strong>
                    <span class="metric-sub">Configured platform forum sections</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Threads</span>
                    <strong class="metric-value">@Model.ForumThreadCount</strong>
                    <span class="metric-sub">All forum threads</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Threads 7d</span>
                    <strong class="metric-value">@Model.ForumThreads7Days</strong>
                    <span class="metric-sub">Threads created in the last 7 days</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Visible Threads</span>
                    <strong class="metric-value">@Model.VisibleForumThreadCount</strong>
                    <span class="metric-sub">Publicly visible forum threads</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Hidden Threads</span>
                    <strong class="metric-value">@Model.HiddenForumThreadCount</strong>
                    <span class="metric-sub">Moderated or hidden forum threads</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Locked Threads</span>
                    <strong class="metric-value">@Model.LockedForumThreadCount</strong>
                    <span class="metric-sub">Threads closed for replies</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Pinned Threads</span>
                    <strong class="metric-value">@Model.PinnedForumThreadCount</strong>
                    <span class="metric-sub">Threads pinned to the top of sections</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Posts</span>
                    <strong class="metric-value">@Model.ForumPostCount</strong>
                    <span class="metric-sub">All forum posts</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Hidden Posts</span>
                    <strong class="metric-value">@Model.HiddenForumPostCount</strong>
                    <span class="metric-sub">Posts hidden by moderation</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Posts 7d</span>
                    <strong class="metric-value">@Model.ForumPosts7Days</strong>
                    <span class="metric-sub">Posts created in the last 7 days</span>
                </article>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.RegistryError))
        {
            <div class="status-error">@Model.RegistryError</div>
        }
        else if (Model.RegistryRuntime != null)
        {
            <section class="metric-section">
                <header class="metric-section-header">
                    <h2>Registry / Poll Metrics</h2>
                </header>

                <div class="metric-grid">
                    <article class="metric-card">
                        <span class="metric-label">Total Listings</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.TotalRecords</strong>
                        <span class="metric-sub">All registry records</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Visible Listings</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.VisibleRows</strong>
                        <span class="metric-sub">Public query projection</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Current Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.CurrentPlayersTotal</strong>
                        <span class="metric-sub">Sum across active listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Votes</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.TotalVotes</strong>
                        <span class="metric-sub">Projected votes across all listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Online</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.OnlineRecords</strong>
                        <span class="metric-sub">Currently online listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Stale</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.StaleRecords</strong>
                        <span class="metric-sub">Polls missed but not offline</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Offline</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.OfflineRecords</strong>
                        <span class="metric-sub">Tracked but offline</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Pending</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.PendingRecords</strong>
                        <span class="metric-sub">Awaiting confirmed runtime state</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Active</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.ActiveRecords</strong>
                        <span class="metric-sub">Lifecycle active listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Delisted</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.DelistedRecords</strong>
                        <span class="metric-sub">Lifecycle delisted listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Disabled</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.DisabledRecords</strong>
                        <span class="metric-sub">Manually disabled listings</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Active Leases</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.ActiveLeases</strong>
                        <span class="metric-sub">Live registry write leases</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Poll Rounds</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Metrics.PollRounds</strong>
                        <span class="metric-sub">Completed poll rounds</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Poll Candidates</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Store.PollCandidates</strong>
                        <span class="metric-sub">Listings queued for polling</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Poll Failures</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Metrics.PollFailures</strong>
                        <span class="metric-sub">Observed poll failures</span>
                    </article>
                </div>
            </section>

            <section class="metric-section">
                <header class="metric-section-header">
                    <h2>Retained History Metrics</h2>
                </header>

                <div class="metric-grid">
                    <article class="metric-card">
                        <span class="metric-label">Servers With History</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.ServersWithHistory</strong>
                        <span class="metric-sub">Listings with retained sample history</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">History Buckets</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.HistoryBucketCount</strong>
                        <span class="metric-sub">Aggregated retained sample buckets</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Retained Avg Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.AveragePlayersRetained.ToString("0.##")</strong>
                        <span class="metric-sub">Average total players across retained buckets</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Retained Peak Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.PeakPlayersRetained</strong>
                        <span class="metric-sub">Highest total players across retained buckets</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Retained Online Ratio</span>
                        <strong class="metric-value">@((Model.RegistryRuntime.Aggregates.OnlineRatioRetained * 100d).ToString("0.#"))%</strong>
                        <span class="metric-sub">Non-offline ratio across retained samples</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Retained Offline Ratio</span>
                        <strong class="metric-value">@((Model.RegistryRuntime.Aggregates.OfflineRatioRetained * 100d).ToString("0.#"))%</strong>
                        <span class="metric-sub">Offline ratio across retained samples</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Servers With Latency</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.ServersWithLatency</strong>
                        <span class="metric-sub">Listings with successful poll samples</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Average Latency</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.AverageLatencyMs.ToString("0.##") ms</strong>
                        <span class="metric-sub">Average latency across retained successes</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Max Latency</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.MaxLatencyMs ms</strong>
                        <span class="metric-sub">Worst observed retained poll latency</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">History Window</span>
                        <strong class="metric-value">@(Model.RegistryRuntime.Aggregates.HistoryWindowStartUtc?.ToString("u") ?? "-")</strong>
                        <span class="metric-sub">Start of retained history window</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">History Window End</span>
                        <strong class="metric-value">@(Model.RegistryRuntime.Aggregates.HistoryWindowEndUtc?.ToString("u") ?? "-")</strong>
                        <span class="metric-sub">End of retained history window</span>
                    </article>
                </div>
            </section>

            <section class="metric-section">
                <header class="metric-section-header">
                    <h2>Advanced Time Window Metrics</h2>
                </header>

                <div class="metric-grid">
                    <article class="metric-card">
                        <span class="metric-label">24h Peak Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.PeakPlayers24Hours</strong>
                        <span class="metric-sub">Highest hourly total across the last 24 hours</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">7d Average Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.AveragePlayers7Days.ToString("0.##")</strong>
                        <span class="metric-sub">Average hourly total across the last 7 days</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">30d Average Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.AveragePlayers30Days.ToString("0.##")</strong>
                        <span class="metric-sub">Average hourly total across the last 30 days</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">7d Uptime Ratio</span>
                        <strong class="metric-value">@((Model.RegistryRuntime.Aggregates.OnlineRatio7Days * 100d).ToString("0.#"))%</strong>
                        <span class="metric-sub">Online-like ratio across hourly samples in the last 7 days</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">30d Uptime Ratio</span>
                        <strong class="metric-value">@((Model.RegistryRuntime.Aggregates.OnlineRatio30Days * 100d).ToString("0.#"))%</strong>
                        <span class="metric-sub">Online-like ratio across hourly samples in the last 30 days</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">All-Time Peak Players</span>
                        <strong class="metric-value">@Model.RegistryRuntime.Aggregates.AllTimePeakPlayers</strong>
                        <span class="metric-sub">Highest observed platform player total</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">All-Time Peak At</span>
                        <strong class="metric-value">@(Model.RegistryRuntime.Aggregates.AllTimePeakPlayersUtc?.ToString("u") ?? "-")</strong>
                        <span class="metric-sub">Timestamp of the observed all-time peak</span>
                    </article>
                </div>
            </section>

            @if (Model.RegistryRuntime.Aggregates.RecentAggregatePoints != null && Model.RegistryRuntime.Aggregates.RecentAggregatePoints.Count > 0)
            {
                <section class="detail-description">
                    <h2>Recent Platform Trend</h2>
                    <div class="server-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Captured</th>
                                    <th>Total Players</th>
                                    <th>Online Ratio</th>
                                    <th>Offline Ratio</th>
                                    <th>Samples</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var point in Model.RegistryRuntime.Aggregates.RecentAggregatePoints.Reverse())
                            {
                                <tr>
                                    <td>@point.CapturedAtUtc.ToString("u")</td>
                                    <td>@point.CurrentPlayersTotal</td>
                                    <td>@((point.OnlineRatio * 100d).ToString("0.#"))%</td>
                                    <td>@((point.OfflineRatio * 100d).ToString("0.#"))%</td>
                                    <td>@point.SampleCount</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }

        <section class="detail-description">
            <h2>Recent Forum Threads</h2>
            @if (Model.RecentForumThreads.Count == 0)
            {
                <div class="status-empty">No forum threads yet.</div>
            }
            else
            {
                <div class="server-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Thread</th>
                                <th>Section</th>
                                <th>Flags</th>
                                <th>Last Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var thread in Model.RecentForumThreads)
                        {
                            <tr>
                                <td>
                                    <a asp-page="/Forums/Thread"
                                       asp-route-sectionSlug="@thread.SectionSlug"
                                       asp-route-threadId="@thread.ThreadId">@thread.Title</a>
                                </td>
                                <td>@thread.SectionTitle</td>
                                <td>
                                    @if (thread.IsPinned)
                                    {
                                        <span class="detail-pill detail-pill-sm">Pinned</span>
                                    }
                                    @if (thread.IsLocked)
                                    {
                                        <span class="detail-pill detail-pill-sm">Locked</span>
                                    }
                                    @if (thread.IsHidden)
                                    {
                                        <span class="detail-pill detail-pill-sm">Hidden</span>
                                    }
                                </td>
                                <td>@thread.LastPostedUtc.ToString("u")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
</div>
