@page
@model UltraSim.Portal.Pages.Servers.IndexModel
@{
    ViewData["Title"] = "Servers";
}

<div class="portal-header">
    <div>
        <h1>Server Listings</h1>
        <p>Live registry-backed listings from the local UltraSim registry service.</p>
    </div>
</div>

<form method="get" class="server-filter">
    <label>
        Search
        <input asp-for="Search" />
    </label>
    <input type="hidden" asp-for="SortBy" />
    <input type="hidden" asp-for="Descending" />
    <button type="submit">Apply</button>
    <a asp-page="/Servers/Index">Clear</a>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-error">@Model.ErrorMessage</div>
}
else if (Model.Entries.Count == 0)
{
    <div class="status-empty">No servers are currently visible.</div>
}
else
{
    <div class="server-list-header">
        <a asp-page="/Servers/Index"
           asp-route-search="@Model.Search"
           asp-route-sortBy="votes"
           asp-route-descending="@Model.GetNextDescending("votes")"
           class="server-list-sort-link">
            Votes @Model.GetSortArrow("votes")
        </a>
        <a asp-page="/Servers/Index"
           asp-route-search="@Model.Search"
           asp-route-sortBy="name"
           asp-route-descending="@Model.GetNextDescending("name")"
           class="server-list-sort-link">
            Name @Model.GetSortArrow("name")
        </a>
        <a asp-page="/Servers/Index"
           asp-route-search="@Model.Search"
           asp-route-sortBy="state"
           asp-route-descending="@Model.GetNextDescending("state")"
           class="server-list-sort-link">
            State @Model.GetSortArrow("state")
        </a>
        <div>Cur/Avg/Max</div>
        <a asp-page="/Servers/Index"
           asp-route-search="@Model.Search"
           asp-route-sortBy="uptime"
           asp-route-descending="@Model.GetNextDescending("uptime")"
           class="server-list-sort-link">
            Uptime @Model.GetSortArrow("uptime")
        </a>
        <a asp-page="/Servers/Index"
           asp-route-search="@Model.Search"
           asp-route-sortBy="registration"
           asp-route-descending="@Model.GetNextDescending("registration")"
           class="server-list-sort-link">
            Verified @Model.GetSortArrow("registration")
        </a>
    </div>

    <div class="server-list-cards">
        @foreach (var entry in Model.Entries)
        {
            <article class="server-list-card">
                <div class="server-list-row">
                    <div class="server-list-field server-list-field-votes">
                        <span class="server-list-value server-list-value-votes">@entry.Row.VoteCount</span>
                    </div>
                    <div class="server-list-field">
                        <span class="server-list-value">
                            <a asp-page="/Servers/Detail" asp-route-serverId="@entry.Row.ServerId">@entry.Row.DisplayName</a>
                        </span>
                    </div>
                    <div class="server-list-field">
                        <span class="server-list-value">@Model.GetPublicStateSummary(entry)</span>
                    </div>
                    <div class="server-list-field">
                        <span class="server-list-value">@Model.GetPlayersSummary(entry)</span>
                    </div>
                    <div class="server-list-field">
                        <span class="server-list-value">@Model.FormatDuration(entry.Row.Uptime)</span>
                    </div>
                    <div class="server-list-field">
                        <span class="server-list-value">@Model.GetRegistrationState(entry)</span>
                    </div>
                </div>

                <div class="server-list-pills">
                    @if (!string.IsNullOrWhiteSpace(entry.Detail?.DiscordUrl))
                    {
                        <a class="detail-pill detail-pill-icon" href="@entry.Detail.DiscordUrl" target="_blank" rel="noopener noreferrer" title="Join Discord" aria-label="Join Discord">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M19.54 5.51a16.4 16.4 0 0 0-4.09-1.27l-.2.41c-.24.5-.51 1.16-.7 1.68a15.25 15.25 0 0 0-4.58 0 17.2 17.2 0 0 0-.71-1.68l-.2-.41a16.3 16.3 0 0 0-4.1 1.27C2.37 9.32 1.62 13.03 2 16.68a16.5 16.5 0 0 0 5.02 2.52l1.07-1.77c-.59-.22-1.15-.49-1.67-.8.14-.1.28-.2.41-.31 3.22 1.5 6.72 1.5 9.9 0 .14.11.27.21.41.31-.52.31-1.08.58-1.67.8l1.07 1.77A16.4 16.4 0 0 0 22 16.68c.45-4.23-.77-7.91-2.46-11.17ZM9.88 14.43c-.97 0-1.76-.9-1.76-2s.78-2 1.76-2c.98 0 1.77.9 1.76 2 0 1.1-.78 2-1.76 2Zm4.24 0c-.97 0-1.76-.9-1.76-2s.78-2 1.76-2c.98 0 1.77.9 1.76 2 0 1.1-.78 2-1.76 2Z" fill="currentColor" />
                            </svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Detail?.WebsiteUrl))
                    {
                        <a class="detail-pill detail-pill-icon" href="@entry.Detail.WebsiteUrl" target="_blank" rel="noopener noreferrer" title="Visit Website" aria-label="Visit Website">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Zm6.93 9h-3.09a15.7 15.7 0 0 0-1.05-4.28A8.03 8.03 0 0 1 18.93 11ZM12 4.04c.83 1.2 1.5 3 1.86 4.96h-3.72C10.5 7.04 11.17 5.24 12 4.04ZM4.23 13h3.11a15.7 15.7 0 0 0 1.04 4.28A8.03 8.03 0 0 1 4.23 13Zm0-2a8.03 8.03 0 0 1 4.15-4.28A15.7 15.7 0 0 0 7.34 11Zm3.11 0h4.16v2H7.34c-.05-.33-.08-.66-.08-1s.03-.67.08-1Zm4.16 8.96c-.83-1.2-1.5-3-1.86-4.96h3.72c-.36 1.96-1.03 3.76-1.86 4.96Zm2.36-6.96H9.64c-.05-.33-.08-.66-.08-1s.03-.67.08-1h4.72c.05.33.08.66.08 1s-.03.67-.08 1Zm.93 4.28A15.7 15.7 0 0 0 16.66 13h3.11a8.03 8.03 0 0 1-4.15 4.28Z" fill="currentColor" />
                            </svg>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Row.Region))
                    {
                        <span class="detail-pill detail-pill-sm">@entry.Row.Region</span>
                    }
                    @foreach (string language in entry.Detail?.LanguagesOrEmpty ?? Array.Empty<string>())
                    {
                        if (!string.IsNullOrWhiteSpace(language))
                        {
                            <span class="detail-pill detail-pill-sm">@language</span>
                        }
                    }
                    @if (entry.Row.WhitelistOnly)
                    {
                        <span class="detail-pill detail-pill-sm">Whitelist Only</span>
                    }
                    @foreach (string tag in entry.Row.TagsOrEmpty)
                    {
                        if (!string.IsNullOrWhiteSpace(tag))
                        {
                            <span class="detail-pill detail-pill-sm">@tag</span>
                        }
                    }
                </div>

                <div class="server-list-description">
                    <div class="description-panel server-list-description-panel">
                        @(string.IsNullOrWhiteSpace(entry.Description) ? "No description yet." : entry.Description)
                    </div>
                </div>
            </article>
        }
    </div>
}
