@page "/Servers/{serverId}"
@model UltraSim.Portal.Pages.Servers.DetailModel
@{
    ViewData["Title"] = Model.Detail?.Row.DisplayName ?? "Server Detail";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-error">@Model.ErrorMessage</div>
}
else if (Model.Detail == null)
{
    <div class="status-empty">Server not found.</div>
}
else
{
    <article class="server-detail">
        <header>
            <h1>@Model.Detail.Row.DisplayName</h1>
        </header>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="@(Model.StatusKind == "warning" ? "status-warning" : "status-success")">@Model.StatusMessage</div>
        }

        <section class="detail-description">
            <h2>Votes</h2>
            <div class="vote-panel">
                <div>
                    <strong class="vote-count">@Model.Detail.Row.VoteCount</strong>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="vote-actions">
                        @if (Model.HasCurrentUserVoted)
                        {
                            <form method="post" asp-page-handler="WithdrawVote" asp-route-serverId="@Model.ServerId">
                                <button type="submit" class="button-secondary">Withdraw Vote</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Vote" asp-route-serverId="@Model.ServerId">
                                <button type="submit">Vote For Server</button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <div class="detail-muted">
                        <a asp-area="Identity" asp-page="/Account/Login">Sign in</a> to vote for this server.
                    </div>
                }
            </div>
        </section>

        <section class="detail-description">
            <h2>State</h2>
            <div class="metric-grid metric-grid-tight">
                <article class="metric-card">
                    <span class="metric-label">State</span>
                    <strong class="metric-value">@DetailModel.GetPublicState(Model.Detail)</strong>
                    <span class="metric-sub">@DetailModel.GetPublicStateDetail(Model.Detail)</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Players Now</span>
                    <strong class="metric-value">@(Model.Detail.Row.CurrentUsers?.ToString() ?? "-")</strong>
                    <span class="metric-sub">Current observed players</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">24h Peak</span>
                    <strong class="metric-value">@(Model.Detail.AdvancedMetrics?.PeakPlayers24Hours.ToString() ?? "-")</strong>
                    <span class="metric-sub">Highest observed players in 24h</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">All-Time Peak</span>
                    <strong class="metric-value">@(Model.Detail.AdvancedMetrics?.AllTimePeakPlayers.ToString() ?? "-")</strong>
                    <span class="metric-sub">Highest observed players ever</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Uptime</span>
                    <strong class="metric-value">@DetailModel.FormatDuration(Model.Detail.Row.Uptime)</strong>
                    <span class="metric-sub">Current runtime uptime</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Registration</span>
                    <strong class="metric-value metric-value-compact">@DetailModel.GetRegistrationStatus(Model.Detail)</strong>
                    @if (!string.IsNullOrWhiteSpace(DetailModel.GetRegistrationDetail(Model.Detail)))
                    {
                        <span class="metric-sub">@DetailModel.GetRegistrationDetail(Model.Detail)</span>
                    }
                </article>
                <article class="metric-card">
                    <span class="metric-label">Queue</span>
                    <strong class="metric-value">@(Model.Detail.Row.QueueLength?.ToString() ?? "-")</strong>
                    <span class="metric-sub">Current queue depth</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Successful Poll</span>
                    <strong class="metric-value metric-value-compact">@DetailModel.FormatTimestamp(Model.Detail.LastSuccessfulPollUtc)</strong>
                    <span class="metric-sub">Last registry poll success</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Failed Poll</span>
                    <strong class="metric-value metric-value-compact">@DetailModel.FormatTimestamp(Model.Detail.LastFailedPollUtc)</strong>
                    <span class="metric-sub">Last registry poll failure</span>
                </article>
                <article class="metric-card">
                    <span class="metric-label">Connect</span>
                    <strong class="metric-value metric-value-compact metric-value-connect">@(Model.Detail.Row.ConnectHint ?? "-")</strong>
                    <span class="metric-sub">Direct connect target</span>
                </article>
            </div>
        </section>

        <section class="detail-description">
            <div class="detail-pill-row">
                @if (!string.IsNullOrWhiteSpace(Model.Detail.DiscordUrl))
                {
                    <a class="detail-pill detail-pill-icon" href="@Model.Detail.DiscordUrl" target="_blank" rel="noopener noreferrer" title="Join Discord" aria-label="Join Discord">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M19.54 5.51a16.4 16.4 0 0 0-4.09-1.27l-.2.41c-.24.5-.51 1.16-.7 1.68a15.25 15.25 0 0 0-4.58 0 17.2 17.2 0 0 0-.71-1.68l-.2-.41a16.3 16.3 0 0 0-4.1 1.27C2.37 9.32 1.62 13.03 2 16.68a16.5 16.5 0 0 0 5.02 2.52l1.07-1.77c-.59-.22-1.15-.49-1.67-.8.14-.1.28-.2.41-.31 3.22 1.5 6.72 1.5 9.9 0 .14.11.27.21.41.31-.52.31-1.08.58-1.67.8l1.07 1.77A16.4 16.4 0 0 0 22 16.68c.45-4.23-.77-7.91-2.46-11.17ZM9.88 14.43c-.97 0-1.76-.9-1.76-2s.78-2 1.76-2c.98 0 1.77.9 1.76 2 0 1.1-.78 2-1.76 2Zm4.24 0c-.97 0-1.76-.9-1.76-2s.78-2 1.76-2c.98 0 1.77.9 1.76 2 0 1.1-.78 2-1.76 2Z" fill="currentColor" />
                        </svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Detail.WebsiteUrl))
                {
                    <a class="detail-pill detail-pill-icon" href="@Model.Detail.WebsiteUrl" target="_blank" rel="noopener noreferrer" title="Visit Website" aria-label="Visit Website">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2a10 10 0 1 0 10 10A10.01 10.01 0 0 0 12 2Zm6.93 9h-3.09a15.7 15.7 0 0 0-1.05-4.28A8.03 8.03 0 0 1 18.93 11ZM12 4.04c.83 1.2 1.5 3 1.86 4.96h-3.72C10.5 7.04 11.17 5.24 12 4.04ZM4.23 13h3.11a15.7 15.7 0 0 0 1.04 4.28A8.03 8.03 0 0 1 4.23 13Zm0-2a8.03 8.03 0 0 1 4.15-4.28A15.7 15.7 0 0 0 7.34 11Zm3.11 0h4.16v2H7.34c-.05-.33-.08-.66-.08-1s.03-.67.08-1Zm4.16 8.96c-.83-1.2-1.5-3-1.86-4.96h3.72c-.36 1.96-1.03 3.76-1.86 4.96Zm2.36-6.96H9.64c-.05-.33-.08-.66-.08-1s.03-.67.08-1h4.72c.05.33.08.66.08 1s-.03.67-.08 1Zm.93 4.28A15.7 15.7 0 0 0 16.66 13h3.11a8.03 8.03 0 0 1-4.15 4.28Z" fill="currentColor" />
                        </svg>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Detail.Row.Region))
                {
                    <span class="detail-pill">@Model.Detail.Row.Region</span>
                }
                @foreach (string language in Model.Detail.LanguagesOrEmpty)
                {
                    if (!string.IsNullOrWhiteSpace(language))
                    {
                        <span class="detail-pill">@language</span>
                    }
                }
                @if (Model.Detail.Row.WhitelistOnly)
                {
                    <span class="detail-pill">Whitelist Only</span>
                }
                @foreach (string tag in Model.Detail.Row.TagsOrEmpty)
                {
                    if (!string.IsNullOrWhiteSpace(tag))
                    {
                        <span class="detail-pill">@tag</span>
                    }
                }
            </div>
        </section>

        <section class="detail-description">
            <h2>Description</h2>
            <div class="description-panel detail-description-body">
                @(string.IsNullOrWhiteSpace(Model.Detail.Description) ? "No description yet." : Model.Detail.Description)
            </div>
        </section>

        @if (Model.Detail.AdvancedMetrics != null)
        {
            <section class="detail-description">
                <h2>Overtime Metrics</h2>
                <div class="metric-grid">
                    <article class="metric-card">
                        <span class="metric-label">24h Peak Players</span>
                        <strong class="metric-value">@Model.Detail.AdvancedMetrics.PeakPlayers24Hours</strong>
                        <span class="metric-sub">Highest observed current players in the last 24 hours</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">7D Average</span>
                        <strong class="metric-value">Players: @DetailModel.FormatNumber(Model.Detail.AdvancedMetrics.AveragePlayers7Days)</strong>
                        <span class="metric-sub">Uptime: @DetailModel.FormatPercent(Model.Detail.AdvancedMetrics.OnlineRatio7Days)</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">30D Average</span>
                        <strong class="metric-value">Players: @DetailModel.FormatNumber(Model.Detail.AdvancedMetrics.AveragePlayers30Days)</strong>
                        <span class="metric-sub">Uptime: @DetailModel.FormatPercent(Model.Detail.AdvancedMetrics.OnlineRatio30Days)</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">All-Time Peak Players</span>
                        <strong class="metric-value">@Model.Detail.AdvancedMetrics.AllTimePeakPlayers</strong>
                        <span class="metric-sub">Peak hit: @DetailModel.FormatTimestamp(Model.Detail.AdvancedMetrics.AllTimePeakPlayersUtc)</span>
                    </article>
                </div>
            </section>
        }

        @if (Model.Detail.HistorySummary != null)
        {
            <section class="detail-description">
                <h2>Sampler History Metrics (@Model.Detail.RecentSamplesOrEmpty.Count/@Model.Detail.RecentSampleCapacity)</h2>
                <div class="metric-grid metric-grid-tight">
                    <article class="metric-card">
                        <span class="metric-label">Average</span>
                        <strong class="metric-value">@DetailModel.FormatNumber(Model.Detail.HistorySummary.AverageCurrentUsers)</strong>
                        <span class="metric-sub">Average current users in retained window</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Max</span>
                        <strong class="metric-value">@Model.Detail.HistorySummary.MaxPeakUsers</strong>
                        <span class="metric-sub">Highest observed peak player count</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Uptime Avg</span>
                        <strong class="metric-value">@($"{DetailModel.FormatPercent(Model.Detail.HistorySummary.OnlineRatio)} : {DetailModel.FormatPercent(Model.Detail.HistorySummary.OfflineRatio)}")</strong>
                        <span class="metric-sub">Online : Offline</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">First Sample</span>
                        <strong class="metric-value">@DetailModel.FormatTimestamp(Model.Detail.HistorySummary.WindowStartUtc)</strong>
                        <span class="metric-sub">Retained sample window start</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Last Sample</span>
                        <strong class="metric-value">@DetailModel.FormatTimestamp(Model.Detail.HistorySummary.WindowEndUtc)</strong>
                        <span class="metric-sub">Retained sample window end</span>
                    </article>
                </div>
            </section>
        }

        @if (Model.Detail.LatencySummary != null)
        {
            <section class="detail-description">
                <h2>Poll Latency</h2>
                <div class="metric-grid">
                    <article class="metric-card">
                        <span class="metric-label">Samples</span>
                        <strong class="metric-value">@Model.Detail.LatencySummary.SampleCount</strong>
                        <span class="metric-sub">Successful poll samples retained</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Average Latency</span>
                        <strong class="metric-value">@DetailModel.FormatNumber(Model.Detail.LatencySummary.AverageLatencyMs) ms</strong>
                        <span class="metric-sub">Average poll latency</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Max Latency</span>
                        <strong class="metric-value">@Model.Detail.LatencySummary.MaxLatencyMs ms</strong>
                        <span class="metric-sub">Worst observed poll latency</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Last Latency</span>
                        <strong class="metric-value">@((Model.Detail.LatencySummary.LastLatencyMs?.ToString() ?? "-")) ms</strong>
                        <span class="metric-sub">Most recent poll latency</span>
                    </article>
                    <article class="metric-card">
                        <span class="metric-label">Poll Failures</span>
                        <strong class="metric-value">@Model.Detail.LatencySummary.FailureCount</strong>
                        <span class="metric-sub">Observed failed polls</span>
                    </article>
                </div>
            </section>
        }

        @if (Model.Detail.AggregateSamplesOrEmpty.Count > 0)
        {
            <section class="detail-description">
                <h2>Hourly Aggregate Samples</h2>
                <div class="server-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Captured</th>
                                <th>Current</th>
                                <th>Peak</th>
                                <th>Health</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var sample in Model.Detail.AggregateSamplesOrEmpty.Reverse().Take(24))
                        {
                            <tr>
                                <td>@sample.CapturedAtUtc.ToString("u")</td>
                                <td>@sample.CurrentUsers</td>
                                <td>@sample.PeakUsers</td>
                                <td>@sample.HealthState</td>
                                <td>@(string.IsNullOrWhiteSpace(sample.Status) ? "-" : sample.Status)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        }

    </article>
}
