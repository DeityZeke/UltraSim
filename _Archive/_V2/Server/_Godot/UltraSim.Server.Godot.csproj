<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UltraSim.Server.Godot</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj/**;.godot\**;.godot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hosting\UltraSim.Server.Hosting.csproj" />
    <ProjectReference Include="..\Network\UltraSim.Server.Network.csproj" />
    <ProjectReference Include="..\Discovery\UltraSim.Server.Discovery.csproj" />
    <ProjectReference Include="..\Scripting\UltraSim.Server.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj/**" />
    <Compile Remove=".godot\**\*.cs" />
    <Compile Remove=".godot/**" />
  </ItemGroup>

</Project>
