<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>UltraSim.Client.Application.Godot</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1734;CS1735</WarningsAsErrors>
    <!-- The editor/development default intentionally exposes both capability families. -->
    <UltraSimEdition Condition="'$(UltraSimEdition)' == ''">Complete</UltraSimEdition>
    <UltraSimNetworkFlavor Condition="'$(UltraSimNetworkFlavor)' == '' And '$(UltraSimEdition)' == 'Online'">ClientOnly</UltraSimNetworkFlavor>
    <UltraSimNetworkFlavor Condition="'$(UltraSimNetworkFlavor)' == '' And '$(UltraSimEdition)' != 'Online'">Full</UltraSimNetworkFlavor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UltraSimEdition)' == 'SinglePlayer'">
    <DefineConstants>$(DefineConstants);ULTRASIM_SINGLE_PLAYER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UltraSimEdition)' == 'Online'">
    <DefineConstants>$(DefineConstants);ULTRASIM_ONLINE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UltraSimEdition)' == 'Complete'">
    <DefineConstants>$(DefineConstants);ULTRASIM_COMPLETE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/UltraSim.Client.Core.csproj" />
    <ProjectReference Include="../StandardUi/UltraSim.Client.StandardUi.csproj" />
    <ProjectReference Include="../../Game/Contracts/UltraSim.Game.Contracts.csproj" />
    <ProjectReference Include="../../Game/World/UltraSim.Game.World.csproj" />
    <ProjectReference Include="../../Kernels/Spatial/UltraSim.Spatial.csproj" />
    <ProjectReference Include="../BuiltInTestWorlds/UltraSim.Client.BuiltInTestWorlds.csproj"
                      Condition="'$(UltraSimEdition)' == 'SinglePlayer' Or '$(UltraSimEdition)' == 'Complete'" />
    <ProjectReference Include="../Local/UltraSim.Client.Local.csproj"
                      Condition="'$(UltraSimEdition)' == 'SinglePlayer' Or '$(UltraSimEdition)' == 'Complete'" />
    <ProjectReference Include="../../Game/Composition/UltraSim.Game.Composition.csproj"
                      Condition="'$(UltraSimEdition)' == 'SinglePlayer' Or '$(UltraSimEdition)' == 'Complete'" />
    <ProjectReference Include="../Network/UltraSim.Client.Network.csproj"
                      Condition="'$(UltraSimEdition)' == 'Online' Or '$(UltraSimEdition)' == 'Complete'" />
    <ProjectReference Include="../../Server/ConceptDemo.LocalHost/UltraSim.Server.ConceptDemo.LocalHost.csproj"
                      Condition="'$(UltraSimEdition)' == 'Complete'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UltraSimEdition)' == 'Online'">
    <Compile Remove="Local/**/*.cs" />
  </ItemGroup>

  <Target Name="ValidateUltraSimEdition" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(UltraSimEdition)' != 'SinglePlayer' And '$(UltraSimEdition)' != 'Online' And '$(UltraSimEdition)' != 'Complete'"
           Text="UltraSimEdition must be SinglePlayer, Online, or Complete; received '$(UltraSimEdition)'." />
    <Error Condition="'$(UltraSimEdition)' == 'Online' And '$(UltraSimNetworkFlavor)' != 'ClientOnly'"
           Text="The Online product must build UltraSim.Network with ClientOnly capabilities." />
    <Error Condition="'$(UltraSimEdition)' == 'Complete' And '$(UltraSimNetworkFlavor)' != 'Full'"
           Text="The Complete product must build the canonical Full UltraSim.Network assembly." />
  </Target>

  <!-- Remove artifacts left by the pre-consolidation multi-Godot-project graph. Godot scans its
       development output during editor reload, so a stale script assembly can otherwise recreate
       duplicate managed type registration after upgrading an existing checkout. -->
  <Target Name="RemoveRetiredGodotScriptAssemblies" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <InactiveGodotConfiguration Condition="'$(Configuration)' == 'Debug'">Release</InactiveGodotConfiguration>
      <InactiveGodotConfiguration Condition="'$(Configuration)' == 'Release'">Debug</InactiveGodotConfiguration>
    </PropertyGroup>
    <ItemGroup>
      <RetiredGodotScriptArtifact Include="$(BaseOutputPath)**/UltraSim.Client.Bootstrap.Godot.*" />
      <RetiredGodotScriptArtifact Include="$(BaseOutputPath)**/UltraSim.Client.Local.Godot.*" />
      <RetiredGodotScriptArtifact Include="$(BaseOutputPath)**/UltraSim.Client.Godot.*" />
      <RetiredGodotScriptArtifact Include="$(BaseOutputPath)**/UltraSim.Client.Playable.Godot.*" />
      <!-- Keep exactly one active configuration of the sole script assembly in the live Godot
           development tree. Product publication is independently staged and inspected. -->
      <RetiredGodotScriptArtifact
          Include="$(BaseOutputPath)$(InactiveGodotConfiguration)/UltraSim.Client.Application.Godot.*"
          Condition="'$(InactiveGodotConfiguration)' != ''" />
      <RetiredGodotScriptArtifact
          Include="$(BaseOutputPath)ExportRelease/**/UltraSim.Client.Application.Godot.*"
          Condition="'$(Configuration)' != 'ExportRelease'" />
    </ItemGroup>
    <Delete Files="@(RetiredGodotScriptArtifact)" />
  </Target>
</Project>
