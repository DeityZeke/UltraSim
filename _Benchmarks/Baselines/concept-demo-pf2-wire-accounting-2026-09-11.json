  "measurementDefinitions": {
    "udpPayloadBytes": "Exact successful UDP datagram payload lengths at the production socket send/receive boundary. Excludes IPv4/IPv6, UDP, link-layer, socket-buffer, HTTP, CAS, and disk bytes.",
    "estimatedIpv4UdpHeaderBytes": "Datagram count multiplied by 28 bytes for an explicitly labeled IPv4 plus UDP header estimate; not part of UDP payload totals and not a NIC/Ethernet measurement.",
    "applicationPayloadBytes": "Logical registered-message payload only; not additive with physical UDP totals.",
    "dataFrameBytes": "Logical encoded data-frame contribution including per-message frame overhead; not additive with physical UDP totals because datagram/security overhead, aggregation, ACKs, keepalives, and retransmission remain physical concerns.",
    "httpBodyBytes": "HTTP response/archive/manifest/blob body bytes only. Excludes HTTP headers and TCP/IP/link framing and is never included in gameplay UDP totals.",
    "direction": "Bot snapshots use sent=client-to-server and received=server-to-client. Server listener snapshots use the inverse perspective.",
    "rates": "Per-client and aggregate rates are cumulative-snapshot deltas divided by one shared explicit measured duration. Production counters are never reset.",
    "reconciliation": "Secure Data plus ACK plus KeepAlive equals secure UDP payload totals. Socket totals preserve any pre-connection/non-secure/unattributed residual separately. Logical lane and message-family totals reconcile only with registered production messages, not with physical framing."
  },
  "architecture": {
    "physicalPath": "NetworkBots or actual exported Online -> ClientOnly UltraSim.Network -> real UDP -> dedicated Direct Connect authority",
    "hotPath": "per-peer/owner-local fixed primitive counters; no per-packet allocation, reflection, dictionary/string classification, or global counter lock",
    "coldPath": "immutable finite lane/message snapshots, sharded owner snapshot commands, finalized generational connection ring, aggregation/report JSON",
    "connectionLifetime": "connection slot plus generation; retired snapshots are immutable and reconnect creates a distinct transport/application lifetime",
    "preConnectionTraffic": "listener/deployment residual; no fabricated application connection identity",
    "httpSeparation": "Client.Content and the static content host expose body/cache counters independently from UDP",
