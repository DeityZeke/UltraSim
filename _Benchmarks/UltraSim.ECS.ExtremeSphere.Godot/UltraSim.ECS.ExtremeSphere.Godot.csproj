<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltraSim.ECS.ExtremeSphere.Core\UltraSim.ECS.ExtremeSphere.Core.csproj" />
    <ProjectReference Include="..\..\Kernels\ECS\UltraSim.ECS.csproj" />
    <ProjectReference Include="..\..\Kernels\ECS.Generators\UltraSim.ECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <Compile Include="..\UltraSim.ECS.ExtremeSphere.V3\Components.cs" Link="Runtime\Components.cs" />
    <Compile Include="..\UltraSim.ECS.ExtremeSphere.V3\SphereSystems.cs" Link="Runtime\SphereSystems.cs" />
  </ItemGroup>

</Project>
