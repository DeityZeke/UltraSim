<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UltraSim.Server.Core">
      <HintPath>..\Core\bin\$(Configuration)\net8.0\UltraSim.Server.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.ECS">
      <HintPath>..\..\Kernels\ECS\bin\$(Configuration)\net8.0\UltraSim.ECS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.Network">
      <HintPath>..\..\Kernels\Network\bin\$(Configuration)\net8.0\UltraSim.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.UI">
      <HintPath>..\..\Kernels\UI\bin\$(Configuration)\net8.0\UltraSim.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildServerNetworkDependencies" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\Core\UltraSim.Server.Core.csproj;..\..\Kernels\ECS\UltraSim.ECS.csproj;..\..\Kernels\Network\UltraSim.Network.csproj;..\..\Kernels\UI\UltraSim.UI.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
