<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1734;CS1735</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Client/Content/UltraSim.Client.Content.csproj" />
    <ProjectReference Include="../../Game/Composition/UltraSim.Game.Composition.csproj" />
    <ProjectReference Include="../../Game/Contracts/UltraSim.Game.Contracts.csproj" />
    <ProjectReference Include="../../Game/Protocol/UltraSim.Game.Protocol.csproj" />
    <ProjectReference Include="../../Game/Replication.Remote/UltraSim.Game.Replication.Remote.csproj" />
    <ProjectReference Include="../../Game/UI/UltraSim.Game.UI.csproj" />
    <ProjectReference Include="../../Kernels/Network/UltraSim.Network.csproj" />
    <ProjectReference Include="../Hosting/UltraSim.Server.Hosting.csproj" />
  </ItemGroup>
</Project>
