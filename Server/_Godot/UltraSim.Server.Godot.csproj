<Project Sdk="Godot.NET.Sdk/4.6.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UltraSim.Server.Godot</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj/**;.godot\**;.godot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hosting\UltraSim.Server.Hosting.csproj" />
    <Reference Include="UltraSim.Server.Network">
      <HintPath>..\Network\bin\$(Configuration)\net8.0\UltraSim.Server.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildServerGodotNetworkDependencies" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\Network\UltraSim.Server.Network.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj/**" />
    <Compile Remove=".godot\**\*.cs" />
    <Compile Remove=".godot/**" />
  </ItemGroup>

</Project>
