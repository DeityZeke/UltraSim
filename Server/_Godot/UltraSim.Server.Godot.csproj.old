<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UltraSim.Server.Godot</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hosting\UltraSim.Server.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".godot\**\*.cs" />
  </ItemGroup>

</Project>
