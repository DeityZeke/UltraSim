<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Admission\UltraSim.Server.Admission.csproj" />
    <Reference Include="UltraSim.Network">
      <HintPath>..\..\Kernels\Network\bin\$(Configuration)\net8.0\UltraSim.Network.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UltraSim.UI">
      <HintPath>..\..\Kernels\UI\bin\$(Configuration)\net8.0\UltraSim.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="BuildServerAccountingDependencies" BeforeTargets="PrepareForBuild">
    <MSBuild
      Projects="..\Admission\UltraSim.Server.Admission.csproj;..\..\Kernels\Network\UltraSim.Network.csproj;..\..\Kernels\UI\UltraSim.UI.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

</Project>
