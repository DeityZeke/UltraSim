<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AssemblyName>UltraSim.Server.Operator</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1734;CS1735</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Framework/ControlPlane/UltraSim.Framework.ControlPlane.csproj" />
    <ProjectReference Include="../../Framework/Persistence/UltraSim.Framework.Persistence.csproj" />
    <ProjectReference Include="../../Game/Persistence/UltraSim.Game.Persistence.csproj" />
    <ProjectReference Include="../../Game/Replication.Remote/UltraSim.Game.Replication.Remote.csproj" />
    <ProjectReference Include="../../Game/UI/UltraSim.Game.UI.csproj" />
    <ProjectReference Include="../../Kernels/Network/UltraSim.Network.csproj" />
  </ItemGroup>
</Project>
