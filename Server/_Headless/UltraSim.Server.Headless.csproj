<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hosting\UltraSim.Server.Hosting.csproj" />
    <ProjectReference Include="..\Network\UltraSim.Server.Network.csproj" />
    <ProjectReference Include="..\Scripting\UltraSim.Server.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\RuntimeTemplate\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
